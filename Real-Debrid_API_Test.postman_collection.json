{
  "info": {
    "name": "Real-Debrid API - Complete Testing Suite",
    "description": "Complete Real-Debrid API testing collection with all endpoints for torrent management, unrestricting links, and downloads",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api_key",
      "value": "YOUR_API_KEY_HERE",
      "type": "string"
    },
    {
      "key": "base_url",
      "value": "https://api.real-debrid.com/rest/1.0",
      "type": "string"
    },
    {
      "key": "torrent_hash",
      "value": "e173ed76a54c425bd556391cec5dea15680861cf",
      "type": "string"
    },
    {
      "key": "torrent_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "magnet_link",
      "value": "magnet:?xt=urn:btih:YOUR_HASH_HERE",
      "type": "string"
    },
    {
      "key": "hoster_link",
      "value": "https://uploaded.net/file/YOUR_FILE_ID",
      "type": "string"
    },
    {
      "key": "first_link",
      "value": "",
      "type": "string"
    },
    {
      "key": "direct_link",
      "value": "",
      "type": "string"
    },
    {
      "key": "torrent_status",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Get User Info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "    console.log('✅ Authenticated as:', json.username);",
                  "    console.log('Type:', json.type);",
                  "    console.log('Premium expires:', json.expiration);",
                  "} else {",
                  "    console.log('❌ Authentication failed');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user",
              "host": ["{{base_url}}"],
              "path": ["user"]
            },
            "description": "Verify API key works and get user info"
          }
        }
      ]
    },
    {
      "name": "📥 Torrents",
      "item": [
        {
          "name": "List All Torrents",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (Array.isArray(json)) {",
                  "    console.log('✅ Found', json.length, 'torrents');",
                  "    if (json.length > 0) {",
                  "        const torrent = json.find(t => t.hash && t.hash.toLowerCase() === pm.variables.get('torrent_hash').toLowerCase());",
                  "        if (torrent) {",
                  "            pm.collectionVariables.set('torrent_id', torrent.id);",
                  "            pm.collectionVariables.set('torrent_status', torrent.status);",
                  "            console.log('✅ Found matching torrent!');",
                  "            console.log('  ID:', torrent.id);",
                  "            console.log('  Status:', torrent.status);",
                  "            console.log('  Hash:', torrent.hash);",
                  "            if (torrent.links && torrent.links.length > 0) {",
                  "                pm.collectionVariables.set('first_link', torrent.links[0]);",
                  "                console.log('  Links:', torrent.links.length);",
                  "            }",
                  "        } else {",
                  "            console.log('❌ Torrent not found in list');",
                  "        }",
                  "    }",
                  "} else {",
                  "    console.log('❌ No torrents found');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/torrents?limit=5000",
              "host": ["{{base_url}}"],
              "path": ["torrents"],
              "query": [
                {
                  "key": "limit",
                  "value": "5000"
                }
              ]
            },
            "description": "Get all user torrents. Auto-finds torrent with matching hash."
          }
        },
        {
          "name": "Get Torrent Info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "    console.log('✅ Torrent info retrieved');",
                  "    console.log('  Filename:', json.filename);",
                  "    console.log('  Status:', json.status);",
                  "    console.log('  Bytes:', json.bytes);",
                  "    if (json.links && json.links.length > 0) {",
                  "        pm.collectionVariables.set('first_link', json.links[0]);",
                  "        console.log('  Links:', json.links.length);",
                  "        console.log('  First link:', json.links[0].substring(0, 60) + '...');",
                  "    } else {",
                  "        console.log('  No links available yet');",
                  "    }",
                  "} else {",
                  "    console.log('❌ Failed to get torrent info');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/torrents/info/{{torrent_id}}",
              "host": ["{{base_url}}"],
              "path": ["torrents", "info", "{{torrent_id}}"]
            },
            "description": "Get detailed info about a torrent including files and links"
          }
        },
        {
          "name": "Add Magnet Link",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "    pm.collectionVariables.set('torrent_id', json.id);",
                  "    console.log('✅ Magnet added! ID:', json.id);",
                  "} else {",
                  "    console.log('❌ Failed to add magnet');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"magnet\": \"{{magnet_link}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/torrents/addMagnet",
              "host": ["{{base_url}}"],
              "path": ["torrents", "addMagnet"]
            },
            "description": "Add a magnet link to Real-Debrid"
          }
        },
        {
          "name": "Select Files",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('✅ Files selected');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"files\": \"all\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/torrents/selectFiles/{{torrent_id}}",
              "host": ["{{base_url}}"],
              "path": ["torrents", "selectFiles", "{{torrent_id}}"]
            },
            "description": "Select files to download. Use 'all' or comma-separated file IDs."
          }
        },
        {
          "name": "Get Active Torrents Count",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/torrents/activeCount",
              "host": ["{{base_url}}"],
              "path": ["torrents", "activeCount"]
            },
            "description": "Get number of currently active torrents"
          }
        },
        {
          "name": "Delete Torrent",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/torrents/delete/{{torrent_id}}",
              "host": ["{{base_url}}"],
              "path": ["torrents", "delete", "{{torrent_id}}"]
            },
            "description": "Delete a torrent from your account"
          }
        }
      ]
    },
    {
      "name": "🔓 Unrestrict",
      "item": [
        {
          "name": "Unrestrict Link",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.download) {",
                  "    pm.collectionVariables.set('direct_link', json.download);",
                  "    console.log('✅ Link unrestricted!');",
                  "    console.log('  Direct link:', json.download.substring(0, 60) + '...');",
                  "    console.log('  Filename:', json.filename);",
                  "    console.log('  Filesize:', json.filesize, 'bytes');",
                  "} else {",
                  "    console.log('❌ No download link found');",
                  "    console.log('Response:', json);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"link\": \"{{first_link}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/unrestrict/link",
              "host": ["{{base_url}}"],
              "path": ["unrestrict", "link"]
            },
            "description": "Unrestrict a hoster link to get direct download"
          }
        },
        {
          "name": "Check Link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"link\": \"{{hoster_link}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/unrestrict/check",
              "host": ["{{base_url}}"],
              "path": ["unrestrict", "check"]
            },
            "description": "Check if a hoster link is downloadable"
          }
        },
        {
          "name": "Unrestrict Folder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"link\": \"{{hoster_link}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/unrestrict/folder",
              "host": ["{{base_url}}"],
              "path": ["unrestrict", "folder"]
            },
            "description": "Unrestrict a folder link"
          }
        }
      ]
    },
    {
      "name": "📥 Downloads",
      "item": [
        {
          "name": "List Downloads",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (Array.isArray(json)) {",
                  "    console.log('✅ Found', json.length, 'downloads');",
                  "    if (json.length > 0) {",
                  "        console.log('  First download:', json[0].filename);",
                  "        console.log('  Download link:', json[0].download ? json[0].download.substring(0, 60) + '...' : 'N/A');",
                  "    }",
                  "} else {",
                  "    console.log('No downloads found');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/downloads?limit=100",
              "host": ["{{base_url}}"],
              "path": ["downloads"],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": "Get user downloads list"
          }
        },
        {
          "name": "Delete Download",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/downloads/delete/{{torrent_id}}",
              "host": ["{{base_url}}"],
              "path": ["downloads", "delete", "{{torrent_id}}"]
            },
            "description": "Delete a download from your list"
          }
        }
      ]
    },
    {
      "name": "🎬 Streaming",
      "item": [
        {
          "name": "Get Streaming Links",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/streaming/transcode/{{torrent_id}}",
              "host": ["{{base_url}}"],
              "path": ["streaming", "transcode", "{{torrent_id}}"]
            },
            "description": "Get transcoding links for a file"
          }
        },
        {
          "name": "Get Media Info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/streaming/mediaInfos/{{torrent_id}}",
              "host": ["{{base_url}}"],
              "path": ["streaming", "mediaInfos", "{{torrent_id}}"]
            },
            "description": "Get media information for a file"
          }
        }
      ]
    },
    {
      "name": "🚀 Full Flow Test",
      "item": [
        {
          "name": "1. Check Authentication",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user",
              "host": ["{{base_url}}"],
              "path": ["user"]
            }
          }
        },
        {
          "name": "2. List Torrents & Find Hash",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/torrents?limit=5000",
              "host": ["{{base_url}}"],
              "path": ["torrents"],
              "query": [
                {
                  "key": "limit",
                  "value": "5000"
                }
              ]
            }
          }
        },
        {
          "name": "3. Get Torrent Info (if links missing)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/torrents/info/{{torrent_id}}",
              "host": ["{{base_url}}"],
              "path": ["torrents", "info", "{{torrent_id}}"]
            }
          }
        },
        {
          "name": "4. Check if Already RD Link",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const link = pm.collectionVariables.get('first_link');",
                  "if (link && (link.includes('real-debrid.com/d/') || link.includes('rdb.rdtorrent.link'))) {",
                  "    console.log('✅ Link is already an RD link - use directly');",
                  "    pm.collectionVariables.set('direct_link', link);",
                  "} else if (link) {",
                  "    console.log('⚠️ Link needs unrestricting:', link.substring(0, 60) + '...');",
                  "} else {",
                  "    console.log('❌ No link available');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user",
              "host": ["{{base_url}}"],
              "path": ["user"]
            },
            "description": "Dummy request to check the link variable"
          }
        },
        {
          "name": "5. Unrestrict Link (if needed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"link\": \"{{first_link}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/unrestrict/link",
              "host": ["{{base_url}}"],
              "path": ["unrestrict", "link"]
            }
          }
        }
      ]
    }
  ]
}
